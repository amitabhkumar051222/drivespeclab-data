&lt;article class="dsl-seo-model-page" data-dsl-key="Tesla|Model Y" data-dsl-brand="Tesla" data-dsl-model="Model Y" data-dsl-year="2026"&gt;
  &lt;header class="dsl-seo-hero"&gt;
